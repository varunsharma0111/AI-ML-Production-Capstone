# Application
APP_ENV=local
APP_NAME=AI/ML Production Capstone API
LOG_LEVEL=INFO

# PostgreSQL. Do not commit real credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/capstone
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# OAuth/OIDC resource-server verification. Values must come from the chosen provider.
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=ai-ml-production-capstone-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
ALLOWED_JWT_ALGORITHMS=RS256
