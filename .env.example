# Application Settings
APP_ENV=local
APP_NAME=AI/ML Production Capstone API
LOG_LEVEL=INFO
DEV_AUTH_MODE=false
PUBLIC_TEST_MODE=false
CORS_ORIGINS=*

# Database Connection (PostgreSQL with asyncpg or SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/capstone
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Redis Connection (Async job queue & Pub/Sub notifications)
REDIS_URL=redis://localhost:6379/0

# OAuth / OIDC Configuration
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=ai-ml-production-capstone-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
ALLOWED_JWT_ALGORITHMS=RS256

# Storage & Artifact Settings
STORAGE_BACKEND=local
STORAGE_PATH=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=auraml-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
